/var/log/vantegra-backup.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    copytruncate
}

/var/log/nginx/*.log {
    daily
    rotate 10
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        [ -s /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)"
    endscript
}
